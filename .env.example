# ==============================================================================
# PRIME STORY - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Renomeie este arquivo para .env no desenvolvimento local ou configure estas
# chaves no painel da Netlify (Site configuration > Environment variables).
# NUNCA comite o arquivo .env real no repositório Git!
# ==============================================================================

# Stripe API Keys (Dashboard Stripe > Desenvolvedores > Chaves de API)
# Modo de Teste: começam com sk_test_ e pk_test_
# Modo de Produção: começam com sk_live_ e pk_live_
STRIPE_SECRET_KEY=sk_test_51...SEU_STRIPE_SECRET_KEY_AQUI...
STRIPE_PUBLISHABLE_KEY=pk_test_51...SUA_STRIPE_PUBLISHABLE_KEY_AQUI...

# Stripe Webhook Secret (Dashboard Stripe > Desenvolvedores > Webhooks)
# Gerado ao criar o endpoint https://seu-dominio.netlify.app/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...SEU_WEBHOOK_SIGNING_SECRET_AQUI...

# Senha de proteção do Backstage Administrativo
ADMIN_PASSWORD=prime2026

# URL base do site (sem barra no final)
SITE_URL=https://primestory.com.br
